{
  "name": "@tailor-cms/xt",
  "version": "1.0.0",
  "description": "Tailor extensions kit",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.js",
    "lint": "pnpm -r --filter=!./examples/**/packages/** run lint",
    "build": "pnpm -r --filter=!./examples/**/packages/** run build",
    "nuke:dist": "pnpm -r --filter=!./examples/**/packages/** run nuke:dist",
    "nuke": "pnpm -r --filter=!./examples/**/packages/** run nuke && pnpm dlx del-cli node_modules"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@inquirer/select": "^5.2.2",
    "eslint": "^9.39.5",
    "prettier": "^3.9.6"
  },
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=26"
  }
}
