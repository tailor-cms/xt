{
  "name": "tce-question-edit",
  "description": "Question element edit component",
  "version": "0.0.1",
  "author": "Studion <info@gostudion.com>",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./dist/index.js"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "pnpm nuke:dist && vue-tsc && vite build",
    "lint": "eslint ./src",
    "lint:fix": "pnpm lint --fix",
    "nuke": "pnpm dlx del-cli dist node_modules",
    "nuke:dist": "pnpm dlx del-cli dist",
    "prepublish": "pnpm build"
  },
  "peerDependencies": {
    "vue": "^3.5.43"
  },
  "dependencies": {
    "@tailor-cms/cek-common": "workspace:*"
  },
  "devDependencies": {
    "@tailor-cms/eslint-config": "workspace:*",
    "@vitejs/plugin-vue": "^6.0.9",
    "tce-question-manifest": "workspace:*",
    "typescript": "^6.0.3",
    "vite": "^8.3.3",
    "vite-plugin-lib-inject-css": "^2.2.2",
    "vue-tsc": "^3.3.12",
    "vuetify": "^4.2.4"
  }
}
